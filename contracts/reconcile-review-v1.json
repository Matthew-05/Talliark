{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:talliark:schemas:reconcile-review:1",
  "title": "Reconcile assisted review v1",
  "description": "Review alongside immutable reconcile-v1 scans. Numerical matches never imply human acceptance. Wire bindings are generated by scripts/generate_reconcile_review.mjs.",
  "oneOf": [
    { "$ref": "#/definitions/ReviewWorkspace" },
    { "$ref": "#/definitions/ReviewRequest" },
    { "$ref": "#/definitions/ReviewResponse" },
    { "$ref": "#/definitions/ReviewWorkerJob" },
    { "$ref": "#/definitions/ReviewWorkerResult" }
  ],
  "definitions": {
    "ReviewBounds": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "ReviewCell": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pageIndex", "bounds", "text", "label", "column", "value", "dash", "origin"],
      "properties": {
        "id": { "type": "string" },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "bounds": { "$ref": "#/definitions/ReviewBounds" },
        "text": { "type": "string" },
        "label": { "type": "string" },
        "column": { "type": "string" },
        "value": { "type": "string", "description": "Canonical exact decimal as recognized; empty when unavailable. Local corrections never overwrite it." },
        "dash": { "type": "boolean" },
        "origin": { "type": "string", "enum": ["scan", "manual"] }
      }
    },
    "ReviewTerm": {
      "type": "object", "additionalProperties": false,
      "required": ["cellId", "coefficient"],
      "properties": {
        "cellId": { "type": "string" },
        "coefficient": { "type": "integer", "enum": [-1, 1], "description": "Operation applied to the printed signed value." }
      }
    },
    "ReviewEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "sum", "delta", "reason"],
      "properties": {
        "state": { "type": "string", "enum": ["exact-match", "difference", "not-evaluable"] },
        "sum": { "type": "string" },
        "delta": { "type": "string", "description": "Target minus selected signed operands; never subject to the detector's plausibility threshold." },
        "reason": { "type": "string" }
      }
    },
    "ReviewEquation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "regionId", "targetId", "terms", "axis", "origin", "decision", "evaluation", "issue", "note", "signature"],
      "properties": {
        "id": { "type": "string" },
        "regionId": { "type": "string" },
        "targetId": { "type": "string" },
        "terms": { "type": "array", "items": { "$ref": "#/definitions/ReviewTerm" } },
        "axis": { "type": "string", "enum": ["vertical", "cross", "manual"] },
        "origin": { "type": "string", "enum": ["detected", "manual"] },
        "decision": { "type": "string", "enum": ["unreviewed", "accepted", "rejected", "deferred"] },
        "evaluation": { "$ref": "#/definitions/ReviewEvaluation" },
        "issue": { "type": "string", "enum": ["open", "explained", "resolved"] },
        "note": { "type": "string", "maxLength": 4000 },
        "signature": { "type": "string", "description": "Digest of the explicit equation, evidence and effective values; acceptance applies only to this signature." }
      }
    },
    "ReviewRegion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pageIndex", "bounds", "label"],
      "properties": {
        "id": { "type": "string" },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "bounds": { "$ref": "#/definitions/ReviewBounds" },
        "label": { "type": "string" }
      }
    },
    "ReviewCorrection": {
      "type": "object", "additionalProperties": false,
      "required": ["cellId", "value", "reason"],
      "properties": {
        "cellId": { "type": "string" },
        "value": { "type": "string", "description": "Reviewer supplied canonical decimal; empty removes the correction." },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "ReviewRevision": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "at", "equations", "corrections", "evidence", "reviewedPages"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "at": { "type": "string" },
        "equations": { "type": "array", "items": { "$ref": "#/definitions/ReviewEquation" } },
        "corrections": { "type": "array", "items": { "$ref": "#/definitions/ReviewCorrection" } },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/ReviewCell" } },
        "reviewedPages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "ReviewArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["scanId", "geometryFingerprint", "revision", "evidence", "regions", "equations", "corrections", "history", "reviewedPages"],
      "properties": {
        "scanId": { "type": "string" },
        "geometryFingerprint": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/ReviewCell" } },
        "regions": { "type": "array", "items": { "$ref": "#/definitions/ReviewRegion" } },
        "equations": { "type": "array", "items": { "$ref": "#/definitions/ReviewEquation" } },
        "corrections": { "type": "array", "items": { "$ref": "#/definitions/ReviewCorrection" } },
        "history": { "type": "array", "items": { "$ref": "#/definitions/ReviewRevision" } },
        "reviewedPages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "ReviewWorkspace": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "documentId", "scanId", "geometryFingerprint", "pageCount", "revision", "evidence", "regions", "equations", "corrections", "history", "archives", "reviewedPages"],
      "properties": {
        "version": { "const": 1 },
        "documentId": { "type": "string" },
        "scanId": { "type": "string", "description": "Hash of immutable scan and selectable document-values evidence, including source identities. Works for unversioned comparisons." },
        "geometryFingerprint": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/ReviewCell" } },
        "regions": { "type": "array", "items": { "$ref": "#/definitions/ReviewRegion" } },
        "equations": { "type": "array", "items": { "$ref": "#/definitions/ReviewEquation" } },
        "corrections": { "type": "array", "items": { "$ref": "#/definitions/ReviewCorrection" } },
        "history": { "type": "array", "items": { "$ref": "#/definitions/ReviewRevision" } },
        "archives": { "type": "array", "items": { "$ref": "#/definitions/ReviewArchive" } },
        "reviewedPages": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "ReviewDraft": {
      "type": "object", "additionalProperties": false,
      "required": ["regionId", "targetId", "terms", "axis"],
      "properties": {
        "regionId": { "type": "string" },
        "targetId": { "type": "string" },
        "terms": { "type": "array", "items": { "$ref": "#/definitions/ReviewTerm" } },
        "axis": { "type": "string", "enum": ["vertical", "cross", "manual"] }
      }
    },
    "ReviewOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["equation", "decision", "correction", "value", "issue", "restore", "page"] },
        "equationId": { "type": "string" },
        "equation": { "$ref": "#/definitions/ReviewDraft" },
        "equationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "decision": { "type": "string", "enum": ["unreviewed", "accepted", "rejected", "deferred"] },
        "correction": { "$ref": "#/definitions/ReviewCorrection" },
        "cell": { "$ref": "#/definitions/ReviewCell" },
        "issue": { "type": "string", "enum": ["open", "explained", "resolved"] },
        "note": { "type": "string", "maxLength": 4000 },
        "revision": { "type": "integer", "minimum": 0 },
        "pageIndex": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "boolean" }
      }
    },
    "ReviewRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "version", "requestId", "pdfId", "mode", "scanId", "expectedRevision", "operations"],
      "properties": {
        "type": { "const": "reconcile-review-request" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "pdfId": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["load", "preview", "commit", "save-workbook"], "description": "Commit automatically updates review XML in the open workbook. Save-workbook is handled only by the Excel host, applies no review operations, and invokes Excel Save for the entire workbook." },
        "scanId": { "type": "string" },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "operations": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/definitions/ReviewOperation" } }
      }
    },
    "ReviewResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "version", "requestId", "pdfId", "status"],
      "properties": {
        "type": { "const": "reconcile-review-response" },
        "version": { "const": 1 },
        "requestId": { "type": "string" },
        "pdfId": { "type": "string" },
        "status": { "type": "string", "enum": ["loaded", "preview", "updated", "workbook-saved", "error"], "description": "Updated returns the authoritative state after a direct review XML write, without a separate save state. Workbook-saved acknowledges Excel Save and carries no replacement workspace." },
        "workspace": { "$ref": "#/definitions/ReviewWorkspace" },
        "evaluation": { "$ref": "#/definitions/ReviewEvaluation" },
        "error": { "type": "string" }
      }
    },
    "ReviewWorkerJob": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "command", "request", "model_base64", "values_base64", "review_base64"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "command": { "const": "reconcile-review" },
        "request": { "$ref": "#/definitions/ReviewRequest" },
        "model_base64": { "type": "string" },
        "values_base64": { "type": "string" },
        "review_base64": { "type": "string" }
      }
    },
    "ReviewWorkerResult": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "status", "response", "review_base64"],
      "properties": {
        "job_id": { "type": "string" },
        "status": { "const": "success" },
        "response": { "$ref": "#/definitions/ReviewResponse" },
        "review_base64": { "type": "string" }
      }
    }
  }
}
