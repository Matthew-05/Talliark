  <Target Name="CopyPythonWorkerToOutput" AfterTargets="CopyWebUiToOutput">
    <Warning Condition="!Exists('$(PythonWorkerDir)\python.exe')" Text="[Talliark] Python OCR runtime not built — $(PythonWorkerDir)\python.exe not found. Run src/python/build-worker.ps1 to build it. OCR will not work until the runtime is present." />
    <Message Condition="Exists('$(PythonWorkerDir)\python.exe')" Text="[Talliark] Copying expanded Python OCR runtime to output…" Importance="high" />
    <ItemGroup Condition="Exists('$(PythonWorkerDir)\python.exe')">
      <PythonWorkerFiles Include="$(PythonWorkerDir)\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutputPath)python\worker" />
    <Delete Files="$(OutputPath)python\worker-runtime.zip" />
    <Copy Condition="Exists('$(PythonWorkerDir)\python.exe')" SourceFiles="@(PythonWorkerFiles)" DestinationFiles="@(PythonWorkerFiles->'$(OutputPath)python\worker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
