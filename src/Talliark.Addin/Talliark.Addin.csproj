      <ViewerUiFiles Include="$(ViewerDistDir)\**\*.*" />
      <!-- file-manager dist → webui/file-manager/ -->
      <FileManagerUiFiles Include="$(FileManagerDistDir)\**\*.*" />
      <!-- document-linker dist → webui/document-linker/ -->
      <DocumentLinkerUiFiles Include="$(DocumentLinkerDistDir)\**\*.*" />
      <ReconcileUiFiles Include="$(ReconcileDistDir)\**\*.*" />
